# PRAYKI · E-Mail-Versand (Resend) – Vorlage
# Diese Datei OHNE echten Key committen. Lege lokal eine ".env" an
# (wird von .gitignore ausgeschlossen) bzw. setze die Variablen im Hosting.

# Dein Resend-API-Key (https://resend.com/api-keys)
RESEND_API_KEY=

# Empfängeradresse (wohin Kontakt-/Bestellmails gehen)
MAIL_TO=peer.thye@icloud.com

# Absender. Ohne eigene verifizierte Domain den Resend-Testabsender lassen:
#   MAIL_FROM=Prayki <onboarding@resend.dev>
# Mit eigener, in Resend verifizierter Domain z. B.:
#   MAIL_FROM=Prayki <shop@deine-domain.de>
MAIL_FROM=Prayki <onboarding@resend.dev>

# Optional: erlaubte Frontend-Herkunft (CORS). Standard: * (alle)
ALLOW_ORIGIN=*

# --- Stripe (Bezahlung) ---
# Secret Key aus dem Stripe-Dashboard (https://dashboard.stripe.com/apikeys).
# Zum Testen den TEST-Key (sk_test_...), später den Live-Key (sk_live_...).
STRIPE_SECRET_KEY=

# Optional: feste Basis-URL für Stripe-Weiterleitungen (sonst automatisch erkannt)
# SITE_URL=https://www.prayki-design.com
